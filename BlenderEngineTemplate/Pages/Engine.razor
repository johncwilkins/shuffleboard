@page "/engine"
@inject IJSRuntime JS
@using Microsoft.JSInterop
@using System
@implements System.IDisposable

<h3>Engine</h3>

<div style="margin-bottom:10px;">
    <strong>Keys down:</strong> @string.Join(", ", _input.KeysDown)
</div>

<div style="margin-bottom:10px;">
    <strong>Last click:</strong> X=@_input.MouseX.ToString("F0"), Y=@_input.MouseY.ToString("F0")
</div>
<div style="margin-bottom:10px;">
    <strong>Picked object:</strong> @_input.PickedObjectName
</div>
<div style="margin-bottom:10px;">
    <strong>Selected object:</strong> @_input.SelectedObjectName
</div>
<div style="margin-bottom:10px;">
    <strong>Object count:</strong> @_objects.Count
</div>
<div style="margin-bottom:10px;">
    <strong>Mouse over canvas:</strong> @_input.IsMouseOverCanvas
</div>
<div style="margin-bottom:10px;">
    <strong>First object position:</strong>
    @(_objects.Count > 0 ? $"{_objects[0].name}: X={_objects[0].x:F2}, Y={_objects[0].y:F2}, Z={_objects[0].z:F2}" : "none")
</div>
<div style="margin-bottom:10px;">
    <strong>Mouse (px):</strong>
    X=@_input.MousePixelX.ToString("F0"),
    Y=@_input.MousePixelY.ToString("F0")
</div>

<div style="margin-bottom:10px;">
    <strong>Mouse (world):</strong>
    X=@_input.MouseX.ToString("F2"),
    Y=@_input.MouseY.ToString("F2"),
    Z=@_input.MouseZ.ToString("F2")
</div>

<div id="viewerHost" style="width:100%; height:80vh; border:1px solid #444;"></div>

@code {
    private bool _initialized = false;
    private System.Timers.Timer? _timer;
    private bool _updating = false;
    private DateTime _lastUpdate = DateTime.UtcNow;
    private DotNetObjectReference<Engine>? _dotNetRef;
    private bool _useEngineCamera = true; //*******set to true for program control, false for orbital*****

    private EngineInputState _input = new();

    private List<SceneObjectState> _objects = new();

    private CameraState _camera = new CameraState
    {
        x = 3,
        y = 3,
        z = 6,
        tx = 0,
        ty = 0,
        tz = 0,
        fov = 60
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;

            _dotNetRef = DotNetObjectReference.Create(this);

            await JS.InvokeVoidAsync(
                "engine.init",
                "viewerHost",
                "/models/Untitled.glb",
                _dotNetRef
            );

            StartLoop();
        }
    }

    private void StartLoop()
    {
        _lastUpdate = DateTime.UtcNow;

        _timer = new System.Timers.Timer(16); // about 60 Hz
        _timer.Elapsed += async (_, __) => await Update();
        _timer.Start();
    }

    private async Task Update()
    {
        ObjectUpdate();

        if (_updating) return;
        _updating = true;

        try
        {

            var now = DateTime.UtcNow;
            double dt = (now - _lastUpdate).TotalSeconds;
            _lastUpdate = now;

            // clamp giant jumps after pause/breakpoint/stall
            if (dt > 0.1)
                dt = 0.1;

            // demo object physics
            foreach (var obj in _objects)
            {
                obj.vx += obj.ax * dt;
                obj.vy += obj.ay * dt;
                obj.vz += obj.az * dt;

                obj.x += obj.vx * dt;
                obj.y += obj.vy * dt;
                obj.z += obj.vz * dt;
            }


            var selected = _objects.FirstOrDefault(o => o.name == _input.SelectedObjectName);
            if (selected is not null)
            {
                double moveSpeed = 1.0;

                if (_input.KeysDown.Contains("a"))
                    selected.x -= moveSpeed * dt;

                if (_input.KeysDown.Contains("d"))
                    selected.x += moveSpeed * dt;

                if (_input.KeysDown.Contains("w"))
                    selected.z -= moveSpeed * dt;

                if (_input.KeysDown.Contains("s"))
                    selected.z += moveSpeed * dt;

                if (_input.KeysDown.Contains("q"))
                    selected.y += moveSpeed * dt;

                if (_input.KeysDown.Contains("e"))
                    selected.y -= moveSpeed * dt;
            }

            // demo camera orbit - comment this out when you want a fixed camera


            var frame = new EngineFrame
            {
                objects = _objects,
                camera = _useEngineCamera ? _camera : null
            };

            await JS.InvokeVoidAsync("engine.applyFrame", frame);

            _input.MouseClicked = false;


        }
        finally
        {
            _updating = false;
        }
    }

    [JSInvokable]
    public async Task OnKeyDown(string key)
    {
        _input.KeysDown.Add(key);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnKeyUp(string key)
    {
        _input.KeysDown.Remove(key);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnMouseClick(double x, double y)
    {
        _input.MouseX = x;
        _input.MouseY = y;
        _input.MouseClicked = true;
        await InvokeAsync(StateHasChanged);
        ClickUpdate(x,y);
    }

    [JSInvokable]
    public async Task OnObjectPicked(string objectName)
    {
        _input.PickedObjectName = string.IsNullOrWhiteSpace(objectName) ? "(none)" : objectName;
        _input.SelectedObjectName = _input.PickedObjectName == "(none)" ? "" : _input.PickedObjectName;
        await InvokeAsync(StateHasChanged);
    }
    [JSInvokable]
    public async Task OnModelObjectsLoaded(LoadedObjectState[] loadedObjects)
    {
        _objects = loadedObjects
            .Where(o => !string.IsNullOrWhiteSpace(o.name))
            .GroupBy(o => o.name)
            .Select(g => g.First())
            .Select(o => new SceneObjectState
            {
                name = o.name,
                x = o.x,
                y = o.y,
                z = o.z,
                rx = o.rx,
                ry = o.ry,
                rz = o.rz,
                vx = 0,
                vy = 0,
                vz = 0,
                ax = 0,
                ay = 0,
                az = 0
            })
            .ToList();

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
        _dotNetRef?.Dispose();
    }
    private SceneObjectState? GetObject(string objectName)
    {
        return _objects.FirstOrDefault(o => o.name == objectName);
    }

    private void SetPosition(string objectName, double x, double y, double z)
    {
        var obj = GetObject(objectName);
        if (obj is null)
            return;

        obj.x = x;
        obj.y = y;
        obj.z = z;
    }

    private void SetRotation(string objectName, double rx, double ry, double rz)
    {
        var obj = GetObject(objectName);
        if (obj is null)
            return;

        obj.rx = rx;
        obj.ry = ry;
        obj.rz = rz;
    }

    private void SetVelocity(string objectName, double vx, double vy, double vz)
    {
        var obj = GetObject(objectName);
        if (obj is null)
            return;

        obj.vx = vx;
        obj.vy = vy;
        obj.vz = vz;
    }

    private void SetAcceleration(string objectName, double ax, double ay, double az)
    {
        var obj = GetObject(objectName);
        if (obj is null)
            return;

        obj.ax = ax;
        obj.ay = ay;
        obj.az = az;
    }
    private void StopObject(string objectName)
    {
        var obj = GetObject(objectName);
        if (obj is null)
            return;

        obj.vx = 0;
        obj.vy = 0;
        obj.vz = 0;

        obj.ax = 0;
        obj.ay = 0;
        obj.az = 0;
    }
    private void SetCameraPosition(double x, double y, double z)
    {
        _camera.x = x;
        _camera.y = y;
        _camera.z = z;
    }

    private void SetCameraTarget(double tx, double ty, double tz)
    {
        _camera.tx = tx;
        _camera.ty = ty;
        _camera.tz = tz;
    }

    private void SetCamera(double x, double y, double z, double tx, double ty, double tz)
    {
        _camera.x = x;
        _camera.y = y;
        _camera.z = z;

        _camera.tx = tx;
        _camera.ty = ty;
        _camera.tz = tz;
    }


    [JSInvokable]
    public async Task OnMouseMove(
        double px, double py,
        double wx, double wy, double wz,
        bool hit)
    {
        // screen coords
        _input.MousePixelX = px;
        _input.MousePixelY = py;

        // world coords
        if (hit)
        {
            _input.MouseX = wx;
            _input.MouseY = wy;
            _input.MouseZ = wz;
        }

        await InvokeAsync(StateHasChanged);
    }
    [JSInvokable]
    public async Task OnMouseOverCanvas(bool isOver)
    {
        _input.IsMouseOverCanvas = isOver;
        await InvokeAsync(StateHasChanged);
    }

    private void ObjectUpdate()
    {
        SetAcceleration("Torus", 0, .01, .01);
        SetAcceleration("Cylinder", 0, 0, .01);
        SetAcceleration("Cube", 0.01, 0, .01);
        if (_input.IsMouseOverCanvas)
        {


            if (_input.MousePixelX < 400) SetCameraPosition(_camera.x + .01, 0, 0); else if (_input.MousePixelX > 800) SetCameraPosition(_camera.x - .01, 0, 0);
        }
    }
    private void ClickUpdate(double x, double y)
    {
        
    }

}